{
  "name": "opencode2-changelog",
  "version": "0.1.0",
  "description": "Read OpenCode 2 release notes in the TUI, translated into your language",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trin4ik/opencode2-changelog.git"
  },
  "homepage": "https://github.com/trin4ik/opencode2-changelog#readme",
  "bugs": {
    "url": "https://github.com/trin4ik/opencode2-changelog/issues"
  },
  "type": "module",
  "exports": {
    ".": "./dist/tui.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "tui.tsx",
    "dist",
    "src",
    "docs/*.md",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node build.mjs",
    "prepack": "npm run build",
    "test": "bun --preload @opentui/solid/preload test/smoke.tsx",
    "format": "prettier --write tui.tsx build.mjs src test docs *.md package.json tsconfig.json",
    "format:check": "prettier --check tui.tsx build.mjs src test docs *.md package.json tsconfig.json"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "peerDependencies": {
    "@opentui/core": "*",
    "@opentui/solid": "*",
    "solid-js": ">=1.9.12 <2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/client": "latest",
    "@opentui/core": "0.6.8",
    "@opentui/solid": "0.6.8",
    "@types/bun": "1.3.10",
    "@types/node": "24.0.0",
    "babel-preset-solid": "1.9.12",
    "prettier": "3.6.2",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
